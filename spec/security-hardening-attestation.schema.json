{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexa.ai/schemas/ee/security-hardening-attestation.v1.json",
  "title": "Vexa security-hardening attestation (in-toto statement)",
  "description": "A signed statement that the adversarial security-hardening process ran against a digest set, with how many independent passes, over what scope, with what confirmed results. Terms are defined EXCLUSIVELY by the sealed definitions document the predicate pins. Claims process-ran, never claims secure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        }
      }
    },
    "predicateType": { "const": "https://vexa.ai/attestations/security-hardening/v1" },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "scope", "agents_run", "lenses", "findings", "definitions"],
      "properties": {
        "release": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "scope": { "enum": ["release-diff", "full-surface"] },
        "agents_run": { "type": "integer", "minimum": 1 },
        "lenses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmed", "fixed", "open"],
          "properties": {
            "confirmed": { "$ref": "#/$defs/sev" },
            "fixed": { "$ref": "#/$defs/sev" },
            "open": { "$ref": "#/$defs/sev" }
          }
        },
        "definitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document", "sha256"],
          "properties": {
            "document": { "const": "security-hardening.v1" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "source": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sev": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
