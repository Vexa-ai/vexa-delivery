# SYNTHETIC station profile — rehearsal station, not a customer.
# Provider/substrate facts the station declares. Never credentials: the ingest
# secret scan (S4) refuses a bundle that carries any.
STATION_NAME=rehearsal
PROVIDER=openshift
KUBERNETES_VERSION=1.31
SCOPE=namespace
NAMESPACE=vexa-rehearsal
ARGOCD_VERSION=v3.5.1
KYVERNO_VERSION=v1.19.0
STORAGE_CLASS=thin-csi
PSA_ENFORCE=restricted
LIMITRANGE_PRESENT=yes
RESOURCEQUOTA_PRESENT=yes
REGISTRY_MIRROR=harbor.example.invalid/vexa-mirror
