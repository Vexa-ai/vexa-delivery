#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""A fake kubectl that answers out of a fixture directory.

VEXA_TEST_FIXTURES names a directory. `get <resource>` prints
<fixtures>/<resource>.json; a resource with no fixture file exits 1 the way a
real kubectl does when RBAC refuses it, which is the case the tool must
degrade through rather than crash on.

A read in ANOTHER namespace — `get <resource> -n argocd` — is answered from
<fixtures>/<namespace>/<resource>.json and NEVER from the flat file, so a
fixture without that directory is a cluster where the operator has no RBAC
next door. Without the split, "is Argo CD installed" would be answered by this
namespace's own deployments, which is the wrong answer arriving quietly.
VEXA_TEST_NAMESPACE names the primary namespace (default `vexa`).

VEXA_TEST_KUBECTL_LOG, when set, records every invocation one per line. That is
how the test suite checks that `--dry-run` prints the commands a real run
ACTUALLY issues, rather than a second, drifting description of them.
"""
import json
import os
import pathlib
import sys

FIX = pathlib.Path(os.environ["VEXA_TEST_FIXTURES"])
argv = sys.argv[1:]

log = os.environ.get("VEXA_TEST_KUBECTL_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(" ".join(["kubectl"] + argv) + "\n")

# strip global flags the tool may pass
while argv and argv[0] in ("--kubeconfig", "--context"):
    argv = argv[2:]

if argv and argv[0] == "version":
    path = FIX / "version.json"
    if not path.is_file():
        sys.stderr.write("the server could not find the requested resource\n")
        sys.exit(1)
    sys.stdout.write(path.read_text())
    sys.exit(0)

if argv and argv[0] == "get":
    resource = argv[1]
    namespace = None
    for i, flag in enumerate(argv):
        if flag == "-n" and i + 1 < len(argv):
            namespace = argv[i + 1]
    primary = os.environ.get("VEXA_TEST_NAMESPACE", "vexa")
    if namespace and namespace != primary:
        path = FIX / namespace / ("%s.json" % resource)
    else:
        path = FIX / ("%s.json" % resource)
    if not path.is_file():
        sys.stderr.write('Error from server (Forbidden): %s is forbidden\n' % resource)
        sys.exit(1)
    sys.stdout.write(path.read_text())
    sys.exit(0)

sys.stderr.write("fake kubectl: unhandled %s\n" % json.dumps(argv))
sys.exit(1)
