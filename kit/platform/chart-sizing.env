# SPDX-License-Identifier: Apache-2.0
# What the delivered chart asks for — READ FROM THE CHART, not chosen here.
#
# render.sh sizes the LimitRange ceiling and the ResourceQuota from these
# numbers. They are recorded rather than fetched because the platform pack is
# rendered on the subscriber's side, where the Vexa chart source is not
# present; `render.sh --chart-values <values.yaml>` recomputes every line below
# from a real file and prints both the recomputed value and this recorded one,
# so a stale record shows up as a difference rather than as a silent default.
#
# PROVENANCE — the whole point of this file. The numbers were extracted on
# 2026-09-06 from
#
#     Vexa-ai/vexa · deploy/helm/charts/vexa/values.yaml
#     branch minutes-mcp-viewer, blob 87758076d3006479dc06cb7fd03b0ff81d51fa14
#
# and cross-checked against the same path on `main` (blob 0226a9ec) — different
# blobs, identical resource figures, so this is not a feature-branch artefact.
# The extraction is: every `resources.limits` / `resources.requests` block in
# the values file (13 containers today), plus the two spawned workload classes
# under `runtime.workloadResources`, which carry ONE value per dimension that
# is both the request and the limit.
#
# The ceiling is 4Gi because postgres asks for 4Gi. That is the number the
# 2026-09-06 rehearsal was refused on — `maximum memory usage per Container is
# 2560Mi, but limit is 4Gi` — against a project ceiling sized for the bot's
# 2Gi memory-backed /dev/shm. A ceiling that clears the bot does not clear the
# delivered set, which is why this is read from the chart and not set to the
# bot's number.

# The largest single container memory limit in the chart, and which container
# it belongs to. This is the LimitRange `max.memory` floor.
CHART_MAX_CONTAINER_MEMORY=4Gi
CHART_MAX_CONTAINER_NAME=postgres

# Every declared container in the chart, summed. Sizes the ResourceQuota.
CHART_CONTAINERS=13
CHART_SUM_LIMITS_MEMORY_MI=12672
CHART_SUM_REQUESTS_MEMORY_MI=3328
CHART_SUM_LIMITS_CPU_M=11100
CHART_SUM_REQUESTS_CPU_M=1300

# PersistentVolumeClaims the chart declares (postgres, minio, redis, agent
# workspaces).
CHART_PVCS=4

# The Pods the runtime SPAWNS at meeting/dispatch time. They are not in the
# chart's own container list, they carry request == limit (Guaranteed QoS), and
# a project quota that does not budget for them refuses the meeting rather than
# the install — which is a failure the subscriber sees and we do not.
CHART_SPAWNED_BOT_MEMORY_MI=2048
CHART_SPAWNED_BOT_CPU_M=1000
CHART_SPAWNED_WORKER_MEMORY_MI=1024
CHART_SPAWNED_WORKER_CPU_M=500

# Argo CD's own footprint in the project when it shares it (the shape
# docs/engineering/openshift-parity.mdx records: ~7 pods). Upstream Argo
# declares NO resources at all, so each of its containers lands on the
# LimitRange default below — which is why the pack's quota arithmetic uses the
# LimitRange defaults for this term rather than a number from Argo.
ARGO_PODS=7
