# Operator-site values for the channel registry. Copy to config/channel.env
# (gitignored — *.env is rejected by .gitignore) and fill in your site's
# coordinates. The RUNBOOK refers to these variables instead of literal
# values; nothing in this repository hardcodes an operator's infrastructure.
#
#   set -a; source config/channel.env; set +a

# The standalone host the registry stack runs on, and the SSH login the
# subscriber tool uses to operate it.
CHANNEL_REGISTRY_HOST=198.51.100.10
CHANNEL_REGISTRY_SSH=root@198.51.100.10

# Where the stack lives on that host: compose file, htpasswd, env.
CHANNEL_ROOT=/srv/channel

# The edge's own public origin — the URL a subscriber pulls from. edge/page
# reads the registry back through THIS, with the caller's own credential, so the
# anonymous/subscriber split in RUNBOOK § 5.2 governs what the channel page can
# see. Set CHANNEL_EDGE_HOST only if that name does not resolve to the host from
# inside it; then point CHANNEL_EDGE_URL at the address and this names the vhost.
CHANNEL_EDGE_URL=https://channel.example.com
CHANNEL_EDGE_HOST=

# Object-storage bucket backing the registry (the distribution copy), and
# the region it lives in.
CHANNEL_BUCKET=example-channel
CHANNEL_BUCKET_REGION=us-east-1

# Off-site replica of the channel bucket: host and path of the nightly
# rclone sync target.
CHANNEL_REPLICA_HOST=replica-host
CHANNEL_REPLICA_PATH=/srv/vexa-channel-replica

# Where minted subscriber credentials are vaulted (a SOPS/age-encrypted env
# file, or your site's equivalent). The tool prints a credential exactly once;
# this is where it goes.
CHANNEL_CREDENTIAL_VAULT=path/to/your/secrets-vault.enc.env

# ---------------------------------------------------------------- claim code
# Delivery by claim code: `vexa_subscriber.py add <sub> --park` seals the
# minted credential to the edge's key and parks it under a six-digit
# single-use code, read aloud on a call. See edge/claim/README.md and onboarding/credential-delivery.md.

# The claim endpoint the subscriber's kit posts to. It sits behind the same
# Caddy edge as the registry, so it is one host through their firewall, not two.
CHANNEL_CLAIM_EDGE=https://channel.example/claim

# The EDGE's age recipients file — its PUBLIC half. The publisher encrypts to
# this and cannot decrypt what it wrote; the private half exists only on the
# edge host, which is what makes a parked ciphertext inert everywhere else.
CHANNEL_CLAIM_EDGE_RECIPIENT=path/to/claim-edge.recipients

# Where parks are placed, by exactly ONE of these two transports:
#   CHANNEL_CLAIM_SPOOL      a directory this host can write (a mount, a sync)
#   CHANNEL_CLAIM_SPOOL_SSH  an scp target on the standalone edge host
# CHANNEL_CLAIM_SPOOL=/srv/channel/claims
CHANNEL_CLAIM_SPOOL_SSH=root@198.51.100.10:/srv/channel/claims
